NEXT_PUBLIC_APP_NAME=ManifestOS.studio
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=https://manifestos.studio

# Founder activity: /ops/activity?key=THIS
# Required in production. Local dev opens the page without it.
ACTIVITY_ADMIN_SECRET=

# Private Vercel Blob store (manifestos-data). Holds activity, waitlist, and Blueprints.
# Local dev writes to ./data instead.
BLOB_READ_WRITE_TOKEN=

# Build-Ready Blueprint (paid path). The buy button only appears when a Stripe key
# AND an AI key are set. Otherwise visitors see a waitlist.
STRIPE_SECRET_KEY=
# 2900 = $29
BLUEPRINT_PRICE_CENTS=2900
# One of these writes the Blueprint. Grok is used first if both are set.
GROK_API_KEY=
GROK_MODEL=grok-4.5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
